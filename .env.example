# Copy to .env and fill in. Everything EXPO_PUBLIC_* is compiled into the app bundle and
# is therefore readable by anyone who downloads it — only publishable keys belong here.
#
# For EAS builds these are not read from .env at all. Non-secret values live in eas.json's
# per-profile `env` blocks; everything below goes in as an EAS secret:
#
#   eas secret:create --scope project --name EXPO_PUBLIC_CONVEX_URL --value https://...
#
# Without that, a production build has no Clerk key and no Convex URL, so it boots
# straight into the "Setup required" screen (app/_layout.tsx).

# Clerk (Configure > API Keys in your Clerk dashboard)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# PostHog (Project Settings > Project API Key)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Convex — run `npx convex dev` once to log in, create/link a project, and have it write this for you.
EXPO_PUBLIC_CONVEX_URL=

# RevenueCat (Project Settings > API Keys). Leave blank to ship without a paywall —
# Pro-gated screens fall back to a "not configured" message instead of crashing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional RevenueCat Test Store API key for Expo Go previews.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=

# --- Convex environment variables ---------------------------------------------------
# These are NOT read from this file. Set them in the Convex dashboard, or with
# `npx convex env set NAME value`. They are listed here so the set is discoverable.
#
#   CLERK_JWT_ISSUER_DOMAIN     already required; see convex/auth.config.ts
#   REVENUECAT_WEBHOOK_SECRET   the Authorization header value configured in the
#                               RevenueCat dashboard. RevenueCat does not sign its
#                               webhooks, so this shared secret is the entire security
#                               boundary — make it long and random. Until it is set, the
#                               endpoint returns 503 rather than accepting unauthenticated
#                               writes to entitlements.
#   REVENUECAT_ACCEPT_SANDBOX   "true" on dev/preview deployments only. Production must
#                               leave this unset, or a TestFlight tester can grant
#                               themselves a paid plan with a sandbox purchase.
#
# Webhook URL: https://<deployment>.convex.site/revenuecat/webhook

# Sentry. Leave the DSN blank and crash reporting is inert — lib/monitoring.ts falls back
# to console.error. SENTRY_ORG and SENTRY_PROJECT are build-time only: they drive source
# map upload, and app.config.js omits the Sentry plugin entirely unless both are set.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time secret, never committed. Set as an EAS secret, not in .env for CI.
SENTRY_AUTH_TOKEN=

# --- Build and release -------------------------------------------------------------
# Run `eas init` once; it prints the project id. Until this is set, app.config.js omits
# both extra.eas.projectId and updates.url, so EAS Update is inert rather than broken.
EAS_PROJECT_ID=
# Your Expo account or organisation slug. Optional for local dev, required for EAS.
EXPO_OWNER=

# App Store Connect, read by eas.json's submit.production profile.
APPLE_ID=
ASC_APP_ID=
APPLE_TEAM_ID=

# --- End-to-end tests --------------------------------------------------------------
# A throwaway Clerk account for the Maestro flows in .maestro/. Never a real user.
MAESTRO_TEST_EMAIL=
MAESTRO_TEST_PASSWORD=
