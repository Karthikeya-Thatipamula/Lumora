# This repo is developed on Windows (core.autocrlf=true) and linted in Linux CI.
# Without this, `prettier --check` with "endOfLine": "lf" passes locally and fails in CI.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.p8 binary
*.p12 binary

package-lock.json linguist-generated=true -diff
convex/_generated/** linguist-generated=true
