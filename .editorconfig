# Keeps editors agreeing with .prettierrc before Prettier ever runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,svg,ttf,otf,woff,woff2,ico}]
insert_final_newline = false
trim_trailing_whitespace = false
